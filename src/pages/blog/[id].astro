---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props as Props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} — vytautas.dev`}
  description={post.data.description ?? post.data.title}
>
  <article class="prose prose-zinc max-w-none">
    <header class="mb-10">
      <h1 class="text-3xl font-medium tracking-tight text-green-800 sm:text-4xl">{post.data.title}</h1>
      <time
        class="mt-2 block text-sm text-zinc-500"
        datetime={post.data.pubDate.toISOString()}
      >
        {post.data.pubDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
      {post.data.tags && post.data.tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <li>
              <span class="rounded bg-green-100 px-2 py-0.5 text-sm text-green-800">{tag}</span>
            </li>
          ))}
        </ul>
      )}
    </header>
    <div class="prose-headings:font-medium prose-headings:text-green-800 prose-a:text-green-700 prose-a:underline prose-a:underline-offset-2">
      <Content />
    </div>
  </article>
</BaseLayout>
