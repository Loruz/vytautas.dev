---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', (p) => !p.data.draft);
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props as Props;
const { Content } = await render(post);
---

<BaseLayout
	title={`${post.data.title} — vytautas.dev`}
	description={post.data.description ?? post.data.title}
	type="article"
	publishedTime={post.data.pubDate}
	image={post.data.image}
>
	<div class="mx-auto w-full">
		<article class="prose prose-zinc max-w-none">
			<header class="mb-10">
				<h1
					class="text-3xl font-medium tracking-tight text-green-800 sm:text-4xl"
					transition:name={`post-title-${post.id}`}
				>
					{post.data.title}
				</h1>
				<time
					class="mt-2 block text-sm text-zinc-500"
					datetime={post.data.pubDate.toISOString()}
				>
					{
						post.data.pubDate.toLocaleDateString('en-US', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})
					}
				</time>
				{
					post.data.tags && post.data.tags.length > 0 && (
						<div class="mt-3 flex flex-wrap gap-2">
							{post.data.tags.map((tag) => (
								<span class="rounded bg-green-100 px-2 py-0.5 text-sm text-green-800">
									{tag}
								</span>
							))}
						</div>
					)
				}
			</header>
			<div
				class="prose-headings:font-medium prose-headings:text-green-800 prose-a:text-green-700 prose-a:underline prose-a:underline-offset-2"
			>
				<Content />
			</div>
		</article>
	</div>
</BaseLayout>
