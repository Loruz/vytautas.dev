---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog"))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<BaseLayout
	title="Vytautas — Developer & Writer"
	description="Personal blog and portfolio"
>
	<div class="space-y-12">
		<section class="border-b border-zinc-200 pb-8">
			<h1
				class="text-3xl font-medium tracking-tight text-green-800 sm:text-4xl"
			>
				<div class="flex items-center gap-4">
					<img
						src="/self.png"
						alt="Vytautas"
						class="w-30 h-30 object-cover inline-block rounded-full"
					/>
					Hi, I'm Vytautas
				</div>
			</h1>
			<p class="mt-4 text-lg text-zinc-600">
				Developer and wannabe technical writer. This is my personal blog
				and and portfolio website — I will share thoughts, ideas, and
				projects I've worked on.
			</p>
		</section>

		{
			posts.length > 0 && (
				<section>
					<h2 class="text-xl font-medium text-green-800">
						<span class="text-zinc-400 font-normal">$ </span>recent --limit 5
					</h2>
					<ul class="mt-4 space-y-2">
						{posts.map((post) => (
							<li class="group flex items-baseline gap-2">
								<span class="text-zinc-400 text-sm shrink-0 group-hover:text-green-600 transition-colors duration-150">→</span>
								<a
									href={`/blog/${post.id}`}
									class="retro-link"
								>
									{post.data.title}
								</a>
								<time
									class="text-sm text-zinc-400 shrink-0"
									datetime={post.data.pubDate.toISOString()}
								>
									{post.data.pubDate.toLocaleDateString(
										'en-US',
										{
											year: 'numeric',
											month: 'short',
											day: 'numeric',
										}
									)}
								</time>
							</li>
						))}
					</ul>
					<p class="mt-6">
						<a
							href="/blog"
							class="retro-btn"
						>
							all posts →
						</a>
					</p>
				</section>
			)
		}
	</div>
</BaseLayout>
