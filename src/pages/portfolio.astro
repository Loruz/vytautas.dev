---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Portfolio — vytautas.dev"
  description="About me and selected projects"
>
  <div class="space-y-16">
    <section>
      <h1 class="text-3xl font-medium tracking-tight text-green-800 sm:text-4xl">Portfolio</h1>
      <p class="mt-4 text-lg text-zinc-600">
        A bit about me and the work I do. You can use this page to introduce yourself,
        highlight projects, talks, or anything you want to showcase.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-medium text-green-800">About</h2>
      <p class="mt-3 text-zinc-600">
        Add your bio, background, and what you're currently focused on. This is your
        self-presentation space.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-medium text-green-800">Projects</h2>
      <p class="mt-3 text-zinc-600">
        List your notable projects, open source work, or side projects here.
      </p>
    </section>
  </div>
</BaseLayout>
