---
interface Props {
	github?: string;
	linkedin?: string;
	email?: string;
	class?: string;
}

const { github, linkedin, email, class: className = "" } = Astro.props;
---

<div class={`flex items-center gap-3 ${className}`.trim()}>
	{github && (
		<a
			href={github}
			target="_blank"
			rel="noopener noreferrer"
			class="retro-btn"
			aria-label="GitHub"
		>
			github
		</a>
	)}
	{linkedin && (
		<a
			href={linkedin.startsWith("http") ? linkedin : `https://${linkedin}`}
			target="_blank"
			rel="noopener noreferrer"
			class="retro-btn"
			aria-label="LinkedIn"
		>
			linkedin
		</a>
	)}
	{email && (
		<a
			href={`mailto:${email}`}
			class="retro-btn"
			aria-label="Email"
		>
			email
		</a>
	)}
</div>
